+{
+    static INT init_w = -1, init_h = -1;
+    if (init_w < 0)
+    {
+        init_w = krnl386_get_config_int( "otvdm", "ForceScreenWidth", 0 );
+        init_h = krnl386_get_config_int( "otvdm", "ForceScreenHeight", 0 );
+        if (init_w < 0) init_w = 0;
+        if (init_h < 0) init_h = 0;
+    }
+    *pw = init_w;
+    *ph = init_h;
+}
