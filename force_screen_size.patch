+++++++    if (!dpiY) dpiY = dpiX;
+++++++    if (!dpiY) return sysdiv;
+++++++    {
+++++++        float mdiv = (float)dpiY / 96.0f;
+++++++        if (!dpi_is_process_unaware() || mdiv <= 1.0f)
+++++++            return 1.0f;
+++++++        return mdiv;
+++++++    }
+++++++}
